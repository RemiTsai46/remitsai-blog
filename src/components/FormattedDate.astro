---
interface Props {
	date: Date;
}

const { date } = Astro.props;

import dayjs from 'dayjs';

const formattedDate = dayjs(date).format('YYYY.MM.DD');
---

<time datetime={date.toISOString()}>
	<!-- {
		date.toLocaleDateString('zh-tw', {
			year: 'numeric',
			month: 'numeric',
			day: 'numeric',
		})
	} -->
	{formattedDate}
</time>
